        }
    }
    while(i<=m){
        c.push_back(a[i]);
        i++;
    }
    while(j<=r){
        c.push_back(a[j]);
        j++;
    }
    for(i=0;i<c.size();i++) {
        a[i+l]=c[i];
    }
    return;
}

void mergeSort(vector<int> &a, int l,int r){
    if(l<r){
        int m=l+(r-l)/2;;
        mergeSort(a,l,m);
        mergeSort(a,m+1,r);
        merge(a,l,m,r);
    }
}
int Solution::solve(vector<int> &a) {
    ans=0;
    mergeSort(a,0,a.size()-1);
    return ans;
}